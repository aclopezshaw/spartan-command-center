{
  "name": "spartan-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ratchet": "node scripts/check-lint-baseline.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "migrate:event-retry-schema": "node --env-file=.env.local scripts/migrate-event-retry-schema.mjs",
    "migrate:notion-core-schemas": "node --env-file=.env.local scripts/migrate-notion-core-schemas.mjs",
    "migrate:rank-progression-schema": "node --env-file=.env.local scripts/migrate-rank-progression-schema.mjs",
    "migrate:readiness-ledger": "node --env-file=.env.local scripts/migrate-readiness-ledger.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "validate:release": "npm run docs:check && npm run test && npm run typecheck && npm run lint:ratchet && npm run build",
    "test:rollover": "node --experimental-strip-types --test tests/campaign-rollover.test.mjs",
    "test:phase-xp": "node --experimental-strip-types --test tests/phase-xp.test.mjs",
    "test:eligibility": "node --experimental-strip-types --test tests/individual-completion.test.mjs",
    "test:ceremonies": "node --experimental-strip-types --test tests/ceremonial-events.test.mjs tests/promotion.test.mjs",
    "test:assignment": "node --experimental-strip-types --test tests/fireteam-assignment.test.mjs",
    "test:cohesion": "node --experimental-strip-types --test tests/unit-cohesion.test.mjs",
    "test:events": "node --experimental-strip-types --test tests/event-readiness.test.mjs tests/event-schedule.test.mjs tests/event-outcome.test.mjs",
    "test:standings": "node --experimental-strip-types --test tests/fireteam-standings.test.mjs",
    "test:hud-backgrounds": "node --experimental-strip-types --test tests/hud-background.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/session-token.test.mjs",
    "test:authorization": "node --experimental-strip-types --test tests/session-token.test.mjs tests/route-authorization.test.mjs",
    "test:campaign": "node --experimental-strip-types --test tests/campaign-rollover.test.mjs tests/phase-xp.test.mjs tests/individual-completion.test.mjs tests/ceremonial-events.test.mjs tests/fireteam-assignment.test.mjs tests/unit-cohesion.test.mjs tests/event-schedule.test.mjs tests/event-outcome.test.mjs tests/fireteam-standings.test.mjs tests/hud-background.test.mjs",
    "test:foundation": "node --experimental-strip-types --test tests/operational-date.test.mjs tests/achievement-rules.test.mjs tests/achievement-scheduling.test.mjs tests/notion-pagination.test.mjs tests/promotion.test.mjs tests/rank-progression.test.mjs tests/rank-insignia.test.mjs tests/readiness-ledger.test.mjs tests/service-history-contract.test.mjs tests/service-history-view.test.mjs tests/session-token.test.mjs tests/single-flight.test.mjs tests/route-authorization.test.mjs tests/lint-ratchet.test.mjs"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
